{
  "empty": "",
  "arithmetic": "let x = 1 + 2 * 3; let b = !(x < 9) || false; x = x - 1;",
  "comments": "# comment\nlet x=1; # tail\n",
  "strings": "let s=\"a\\n\\t\\r\\\\\\\"\";",
  "plain-heredoc": "let s=<<TAG;\nhello ${not_a_field}\nTAG\n",
  "dedent-heredoc": "let s=<<~TAG;\n  body\n  TAG\n",
  "empty-heredoc": "let s=<<E;\nE\n",
  "queued-heredocs": "pair(<<A, <<B);\nfirst\nA\nsecond\nB\n",
  "queue-same-tag": "pair(<<A, <<A);\nfirst\nA\nsecond\nA\n",
  "queue-across-statements": "let a=<<A; let b=<<B;\na\nA\nb\nB\n",
  "heredoc-in-argument-continuation": "pair(<<A,\na\nA\n42);",
  "json-heredoc": "let x=json <<J;\n{ \"x\": true }\nJ\n",
  "raw-body-delimiters": "let s=<<RAW;\nend _lmcode_\n# not a code comment\n\"\"\" } ${foo}\nRAW\n",
  "qw": "let x=qw(alpha beta path/to/file x-y $dollar café);",
  "qi": "let x=qi(0 -2 9223372036854775807);",
  "qf": "let x=qf(0 -0.25 1e-30 2E+3);",
  "quoted-comments": "let x=qw(a # not a closer )\nb);",
  "quoted-empty": "let a=qw();let b=qi();let c=qf();",
  "quoted-methods": "let a=qw(a b).len();let b=qi(1 2).at(0);",
  "quote-names": "let qw=1;fn qi(x:int)->int{return x;}let y=object.qf(3);let json=2;json(4);",
  "maps": "let a=%();let b=%(word=>1,\"text\"=>2,(\"x\"+\"y\")=>3,);",
  "modulo": "let n=5%(2);let m=10%3;",
  "loops": "for(i in range(0,4)){while(false){break;}continue;}for(item in items){use(item);}",
  "conditions": "if(true){use(1);}else if(false){use(2);}else{use(3);}",
  "switch": "switch(n){case -1:{use(1);}case 2:{use(2);}default:{use(0);}}",
  "enum-switch": "switch(c){case Color.Red:{use(c);}default:{use(Color.Blue);}}",
  "functions": "fn count(x:Thing,n:int)->int {let y=x.size()+n;return y;}fn notify()->void {emit();}",
  "entries": "@function_definition fn rule(n:Node)->bool implements Rule{return n.valid();}",
  "keyword-annotation": "@if fn rule(n:Node)->void implements Visitor {use(n);}",
  "method-chains": "let x=root.child(0).name();let e=Color.Red;",
  "return-forms": "$return=7;$return=null;$return.name=\"x\";$return[\"dynamic\"+str(1)]=null;",
  "return-in-entry": "@item fn rule(n:Node)->int implements Score{$return.name=n.name();return 7;}",
  "splice-structure": "let x=${pick({key: ARGV[0], values:[1,2]})};",
  "splice-condition": "let x=${a ? b[0] : c.value};",
  "splice-string-braces": "let x=${f\"name {lookup({key:1})} {{literal}}\"};",
  "splice-comments": "let x=${1 /* } */ + 2 // }\n};",
  "splice-header-newline": "pair(<<A, ${\"\"\"multi\nline\"\"\"});\nreal body\nA\n",
  "splice-tuple": "let x=${(1,2,)};let y=${()};",
  "splice-values-and-system": "let x=${[true,false,null]}; let y=${system([\"echo\", \"data\"])}; $return.return=1;\n"
}
