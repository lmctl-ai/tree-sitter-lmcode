{
  "name": "tree-sitter-lmcode",
  "version": "0.1.0",
  "description": "Tree-sitter syntax grammar for lmcode",
  "license": "MIT",
  "repository": "https://github.com/lmctl-ai/tree-sitter-lmcode",
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "src/**",
    "queries/**"
  ],
  "devDependencies": {
    "tree-sitter-cli": "0.27.1"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test --rebuild",
    "test:conformance": "python3 scripts/conformance.py",
    "test:controls": "python3 scripts/controls.py",
    "test:all": "npm run generate && npm test && npm run test:conformance && python3 scripts/negative.py && python3 scripts/incremental.py && python3 scripts/scanner-limits.py && npm run test:controls"
  }
}
